{
  "version":1,
  "name":"Secret treasury, plain chests and a single entrance",
  "initial":"empty",
  "steps":[
    {"action":"build","tool":"DIG","cell":[8,8]},
    {"action":"build","tool":"DIG","cell":[6,8]},
    {"action":"build","tool":"DIG","cell":[5,8]},
    {"action":"build","tool":"DIG","cell":[4,8]},
    {"action":"build","tool":"DIG","cell":[3,8]},
    {"action":"build","tool":"DIG","cell":[3,7]},
    {"action":"build","tool":"DIG","cell":[4,7]},
    {"action":"build","tool":"STORE","cell":[4,7]},
    {"action":"build","tool":"STORE","cell":[4,8]},
    {"action":"build","tool":"STORE","cell":[3,7]},
    {"action":"build","tool":"STORE_LOCKED","cell":[3,8]},
    {"action":"assert","probe":"treasure:3:7","op":"exists","value":false},
    {"action":"undo"},
    {"action":"assert","probe":"treasure:3:7","op":"exists","value":false},
    {"action":"build","tool":"STORE","cell":[3,8]},
    {"action":"assert","probe":"treasure:3:7","op":"exists","value":true},
    {"action":"assert","probe":"treasure:3:7","field":"side","op":"eq","value":"E"},
    {"action":"assert","probe":"treasure:3:7","field":"entrance","op":"eq","value":[5,8]},
    {"action":"assert","probe":"treasure:3:7","field":"capacity","op":"eq","value":900},
    {"action":"assert","probe":"economy","field":"capacity","op":"eq","value":900},
    {"action":"assert","probe":"vault:3:7","field":"capacity","op":"eq","value":225},
    {"action":"assert","probe":"treasure:3:7","field":"gold","op":"eq","value":290},
    {"action":"build","tool":"DIG","cell":[4,6]},
    {"action":"assert","probe":"treasure:3:7","op":"exists","value":false},
    {"action":"assert","probe":"economy","field":"capacity","op":"eq","value":600},
    {"action":"undo"},
    {"action":"assert","probe":"treasure:3:7","op":"exists","value":true},
    {"action":"build","tool":"STORE_LOCKED","cell":[4,8]},
    {"action":"assert","probe":"treasure:3:7","op":"exists","value":false},
    {"action":"undo"},
    {"action":"assert","probe":"treasure:3:7","op":"exists","value":true},
    {"action":"build","tool":"DIG","cell":[3,8]},
    {"action":"assert","probe":"treasure:3:7","op":"exists","value":false},
    {"action":"undo"},
    {"action":"assert","probe":"treasure:3:7","op":"exists","value":true}
  ]
}
