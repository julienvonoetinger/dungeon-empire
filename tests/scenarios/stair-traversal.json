{
  "version":1,
  "name":"Stair descent before exploration and ascent before departure",
  "initial":"prepared",
  "seed":21,
  "steps":[
    {"action":"start_raid"},
    {"action":"assert","probe":"hero","field":"entering","op":"eq","value":true},
    {"action":"assert","probe":"hero","field":"enter_t","op":"eq","value":0.48},
    {"action":"pause","value":true},
    {"action":"advance","seconds":1},
    {"action":"assert","probe":"hero","field":"enter_t","op":"eq","value":0.48},
    {"action":"pause","value":false},
    {"action":"advance","seconds":0.45},
    {"action":"assert","probe":"hero","field":"entering","op":"eq","value":true},
    {"action":"assert","probe":"hero","field":"pos","op":"eq","value":[3,8]},
    {"action":"assert","probe":"hero","field":"turns","op":"eq","value":0},
    {"action":"checkpoint","label":"Descent finishes before exploration begins"},
    {"action":"advance","seconds":0.05},
    {"action":"assert","probe":"hero","field":"entering","op":"exists","value":false},
    {"action":"wait","probe":"hero","field":"exit_arrival_t","op":"exists","value":true,"timeout":90},
    {"action":"assert","probe":"hero","field":"pos","op":"eq","value":[3,8]},
    {"action":"assert","probe":"hero","field":"exiting","op":"exists","value":false},
    {"action":"wait","probe":"hero","field":"exiting","op":"exists","value":true,"timeout":2},
    {"action":"assert","probe":"raid","field":"stats.escaped","op":"eq","value":0},
    {"action":"checkpoint","label":"Returned to stair centre, ascent still required"},
    {"action":"pause","value":true},
    {"action":"advance","seconds":1},
    {"action":"assert","probe":"hero","field":"exit_t","op":"eq","value":0.48},
    {"action":"pause","value":false},
    {"action":"advance","seconds":0.2},
    {"action":"assert","probe":"hero","field":"present","op":"eq","value":true},
    {"action":"assert","probe":"raid","field":"active","op":"eq","value":true},
    {"action":"wait","probe":"raid","field":"active","op":"eq","value":false,"timeout":1},
    {"action":"assert","probe":"hero","field":"present","op":"eq","value":false},
    {"action":"assert","probe":"raid","field":"result.escaped","op":"eq","value":1},
    {"action":"checkpoint","label":"Hero removed only after completing the ascent"}
  ]
}
